// SpyGlass CDC constraints for the asynchronous CAN FIFOs beneath
// can_channel_core.

current_design "can_channel_core"

// TX and RX FIFOs use APB writes/reads and CAN-domain reads/writes.
clock -name "pclk"    -period 10.0 -edge {0.0 5.0}  -domain "APB"
clock -name "can_clk" -period 25.0 -edge {0.0 12.5} -domain "CAN"

reset -name "presetn"  -value 0 -async
reset -name "can_rst_n" -value 0 -async

// TX FIFO: write pointer crosses APB -> CAN and read pointer CAN -> APB.
qualifier -from_clk "pclk" -to_clk "can_clk" \
          -dest_reg "u_tx_path_core.u_tx_fifo.u_can_fifo.wr_ptr_sync.S1" \
                     "u_tx_path_core.u_tx_fifo.u_can_fifo.wr_ptr_sync.S2"
qualifier -from_clk "can_clk" -to_clk "pclk" \
          -dest_reg "u_tx_path_core.u_tx_fifo.u_can_fifo.rd_ptr_sync.S1" \
                     "u_tx_path_core.u_tx_fifo.u_can_fifo.rd_ptr_sync.S2"

// RX FIFO: write pointer crosses CAN -> APB and read pointer APB -> CAN.
qualifier -from_clk "can_clk" -to_clk "pclk" \
          -dest_reg "u_rx_path.u_rx_fifo.u_can_fifo.wr_ptr_sync.S1" \
                     "u_rx_path.u_rx_fifo.u_can_fifo.wr_ptr_sync.S2"
qualifier -from_clk "pclk" -to_clk "can_clk" \
          -dest_reg "u_rx_path.u_rx_fifo.u_can_fifo.rd_ptr_sync.S1" \
                     "u_rx_path.u_rx_fifo.u_can_fifo.rd_ptr_sync.S2"

fifo -memory "u_tx_path_core.u_tx_fifo.u_can_fifo"
fifo -memory "u_rx_path.u_rx_fifo.u_can_fifo"

input  -name "pclk"     -clock "pclk"
input  -name "can_clk"  -clock "can_clk"
input  -name "presetn"  -clock "pclk"
input  -name "can_rst_n" -clock "can_clk"

output -name "reg_rdata" -clock "pclk"
output -name "can_tx"    -clock "can_clk"