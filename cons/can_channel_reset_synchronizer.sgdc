// SpyGlass CDC constraints for the CAN-domain reset synchronizer.

current_design "can_channel_core"

clock -name "pclk"    -period 10.0 -edge {0.0 5.0}  -domain "APB"
clock -name "can_clk" -period 25.0 -edge {0.0 12.5} -domain "CAN"

reset -name "presetn"  -value 0 -async
reset -name "can_rst_n" -value 0 -async

reset_synchronizer -name "can_reset_sync.S2" \
                   -clock "can_clk"

input  -name "pclk"     -clock "pclk"
input  -name "can_clk"  -clock "can_clk"
input  -name "presetn"  -clock "pclk"
input  -name "can_rst_n" -clock "can_clk"

output -name "can_tx"  -clock "can_clk"
output -name "can_irq" -clock "pclk"