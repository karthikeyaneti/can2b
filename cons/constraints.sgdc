//=============================================================================
// SpyGlass CDC & Lint Constraint File (.sgdc) for Asynchronous FIFO (can_fifo)
// Design: can_fifo
//=============================================================================

current_design "can_fifo"

//-----------------------------------------------------------------------------
// 1. Clock Definitions
// Clocks matching testbench periods:
//   wr_clk: Period = 10.0 ns (100 MHz), 50% duty cycle
//   rd_clk: Period = 25.0 ns (40 MHz),  50% duty cycle
//-----------------------------------------------------------------------------
clock -name "can_fifo.wr_clk" -period 10.0 -edge {0.0 5.0}  -domain "DOMAIN_WR"
clock -name "can_fifo.rd_clk" -period 25.0 -edge {0.0 12.5} -domain "DOMAIN_RD"

//-----------------------------------------------------------------------------
// 2. Reset Definitions & Reset Synchronizer Declarations
//-----------------------------------------------------------------------------
reset -name "can_fifo.wr_rst_n" -value 0 -async
reset -name "can_fifo.rd_rst_n" -value 0 -async

// Declare reset synchronizers to prevent Reset_sync04 warning
reset_synchronizer -name "can_fifo.wr_reset_sync.S2" -clock "can_fifo.wr_clk" -reset "can_fifo.wr_rst_n"
reset_synchronizer -name "can_fifo.rd_reset_sync.S2" -clock "can_fifo.rd_clk" -reset "can_fifo.rd_rst_n"

//-----------------------------------------------------------------------------
// 3. Synchronizers & Gray-encoded Multi-bit Data
//-----------------------------------------------------------------------------
// Qualify the two-FF synchronizer destinations for Gray pointers
qualifier -from_clk "can_fifo.wr_clk" -to_clk "can_fifo.rd_clk" -dest_reg "can_fifo.wr_ptr_sync.S1" "can_fifo.wr_ptr_sync.S2"
qualifier -from_clk "can_fifo.rd_clk" -to_clk "can_fifo.wr_clk" -dest_reg "can_fifo.rd_ptr_sync.S1" "can_fifo.rd_ptr_sync.S2"

//-----------------------------------------------------------------------------
// 4. FIFO Memory Recognition for CDC & Lint (Waives Ac_unsync02 & STARC Lint)
//-----------------------------------------------------------------------------
fifo -memory "fifo_mem" \
     -wr_data "can_fifo.wr_data" \
     -rd_data "can_fifo.rd_data" \
     -wr_ptr "can_fifo.wr_ptr" \
     -rd_ptr "can_fifo.rd_ptr"

// Instruct SpyGlass that fifo_mem is a Memory/RAM array (no async reset needed)
waive -rule "STARC-2.3.4.3" -tag "RAM_NO_ASYNC_RESET" -comment "FIFO RAM array does not require async reset"
waive -rule "STARC05-1.3.1.3" -tag "RAM_ENABLE_GATE" -comment "FIFO RAM enable gating"

//-----------------------------------------------------------------------------
// 5. Port Domain Associations (Inputs & Outputs)
//-----------------------------------------------------------------------------
input -name "can_fifo.wr_en"   -clock "can_fifo.wr_clk"
input -name "can_fifo.wr_data" -clock "can_fifo.wr_clk"

input -name "can_fifo.rd_en"   -clock "can_fifo.rd_clk"

output -name "can_fifo.rd_data" -clock "can_fifo.rd_clk"
output -name "can_fifo.empty"   -clock "can_fifo.rd_clk"
output -name "can_fifo.full"    -clock "can_fifo.wr_clk"