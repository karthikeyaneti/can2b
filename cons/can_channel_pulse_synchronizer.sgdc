// SpyGlass CDC constraints for pulse_synchronizer instances in
// can_channel_core.  Both CDC directions are present in the design.

current_design "can_channel_core"

clock -name "pclk"    -period 10.0 -edge {0.0 5.0}  -domain "APB"
clock -name "can_clk" -period 25.0 -edge {0.0 12.5} -domain "CAN"

reset -name "presetn"  -value 0 -async
reset -name "can_rst_n" -value 0 -async

// APB (100 MHz) to CAN (40 MHz): reset request pulse.
qualifier -from_clk "pclk" -to_clk "can_clk" \
          -dest_reg "srst_sync.dst_sync1" "srst_sync.dst_sync2"

// CAN (40 MHz) to APB (100 MHz): event pulses.
qualifier -from_clk "can_clk" -to_clk "pclk" \
          -dest_reg "tx_ok_sync.dst_sync1" "tx_ok_sync.dst_sync2"
qualifier -from_clk "can_clk" -to_clk "pclk" \
          -dest_reg "tx_err_sync.dst_sync1" "tx_err_sync.dst_sync2"
qualifier -from_clk "can_clk" -to_clk "pclk" \
          -dest_reg "arblst_sync.dst_sync1" "arblst_sync.dst_sync2"
qualifier -from_clk "can_clk" -to_clk "pclk" \
          -dest_reg "rx_ok_sync.dst_sync1" "rx_ok_sync.dst_sync2"

input  -name "pclk"     -clock "pclk"
input  -name "can_clk"  -clock "can_clk"
input  -name "presetn"  -clock "pclk"
input  -name "can_rst_n" -clock "can_clk"

output -name "can_irq" -clock "pclk"
output -name "can_tx"  -clock "can_clk"