// SpyGlass lint and CDC constraints for pulse_synchronizer_wrapper.

current_design "pulse_synchronizer_wrapper"

clock -name "src_clk" -period 10.0 -edge {0.0 5.0} -domain "SOURCE"
clock -name "dst_clk" -period 25.0 -edge {0.0 12.5} -domain "DESTINATION"
reset -name "src_rst_n" -value 0 -async
reset -name "dst_rst_n" -value 0 -async

qualifier -from_clk "src_clk" -to_clk "dst_clk" \
          -dest_reg "u_sync.dst_sync1" "u_sync.dst_sync2"

input  -name "src_clk"   -clock "src_clk"
input  -name "src_rst_n" -clock "src_clk"
input  -name "src_pulse" -clock "src_clk"
input  -name "dst_clk"   -clock "dst_clk"
input  -name "dst_rst_n" -clock "dst_clk"
output -name "dst_pulse" -clock "dst_clk"