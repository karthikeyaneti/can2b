// SpyGlass lint and CDC constraints for pulse_synchronizer_wrapper.

current_design "pulse_synchronizer_wrapper"

// CAN source clock: representative 20 MHz Clocking Wizard output.
// Keep this period equal to the implemented can_clk frequency.
clock -name "src_clk" -period 50.0 -edge {0.0 25.0} -domain "CAN"
// APB/PS destination clock: Blackboard FCLK_CLK0 default is 100 MHz.
clock -name "dst_clk" -period 10.0 -edge {0.0 5.0} -domain "APB"
reset -name "src_rst_n" -value 0 -async
reset -name "dst_rst_n" -value 0 -async

reset_synchronizer -name "u_src_reset.S2" \
				   -clock "src_clk" \
				   -reset "src_rst_n" \
				   -value 0
reset_synchronizer -name "u_dst_reset.S2" \
				   -clock "dst_clk" \
				   -reset "dst_rst_n" \
				   -value 0

input  -name "src_pulse" -clock "src_clk"
output -name "dst_pulse" -clock "dst_clk"